{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Dashboard",
  "version": "0.1.0",
  "identifier": "com.seoju.music-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Dashboard",
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sejun3232/music-dashboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEODQ3RTYyQTZGRDg1MEQKUldRTmhmMm1ZbjZFSFpFTDZNaFYzdkloZ21GaGc2Wm1Mbi9tUmpaMGZmK2FjZ2NhaE1SdHBBUHQK"
    }
  }
}
